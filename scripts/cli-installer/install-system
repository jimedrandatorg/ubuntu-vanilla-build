step_keyboard() {
    step "Keyboard"
    hr
    info "Choose your keyboard layout. Default if you press Enter: us"

    local default_layout="us"
    if [ "$UI_MODE" = "tui" ]; then
        local args=() tag pretty
        while IFS=$'\t' read -r tag pretty; do
            [ -z "$tag" ] && continue
            args+=("$tag" "$pretty")
        done < <(read_xkb_layouts)
        tui_menu "Keyboard" "Pick a keyboard layout (default: us)" "$default_layout" "${args[@]}"
        KEYBOARD_LAYOUT="$REPLY"
    else
        info "Common layouts:"
        local lines=() tag pretty
        while IFS=$'\t' read -r tag pretty; do
            [ -z "$tag" ] && continue
            lines+=("$tag")
        done < <(read_xkb_layouts)
        local i=1
        while IFS=$'\t' read -r tag pretty; do
            [ -z "$tag" ] && continue
            printf '  %3d) %-8s %s\n' "$i" "$tag" "$pretty"
            i=$((i+1))
        done < <(read_xkb_layouts)
        text_input "Choose a layout by number, or type a custom XKB name" "1"
        if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le "${#lines[@]}" ]; then
            KEYBOARD_LAYOUT="${lines[$((REPLY-1))]}"
        else
            KEYBOARD_LAYOUT="$REPLY"
        fi
    fi
    KEYBOARD_VARIANT=""
    ok "Keyboard layout: $KEYBOARD_LAYOUT"
}

