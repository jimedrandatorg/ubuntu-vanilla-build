list_all_timezones() {
    if [ -d /usr/share/zoneinfo/posix ]; then
        find /usr/share/zoneinfo/posix -mindepth 1 -type f -printf '%P\n' | sort
    elif [ -d /usr/share/zoneinfo ]; then
        find /usr/share/zoneinfo -mindepth 1 -type f -printf '%P\n' | sort
    else
        warn "No zoneinfo directory found; falling back to UTC."
        echo "UTC"
    fi
}

step_timezone() {
    step "Timezone"
    hr

    # Try NTP sync first if connected.
    if [ "$USE_NTP" -eq 1 ] && command -v timedatectl >/dev/null 2>&1; then
        info "Checking internet connectivity for NTP sync..."
        if timeout 5 bash -c "</dev/tcp/2.pool.ntp.org/123" 2>/dev/null; then
            info "Internet reachable — attempting NTP sync via systemd-timesyncd..."
            timedatectl set-ntp true >/dev/null 2>&1 || true
            sleep 2
            local ntp_status
            ntp_status="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)"
            if [ "$ntp_status" = "yes" ]; then
                ok "System clock synchronised with NTP."
            else
                warn "NTP not yet synchronised — falling back to live session clock."
            fi
        else
            warn "No internet — NTP sync skipped. Using live session clock."
        fi
    fi

    local current_tz guess_default
    guess_default="America/New_York"  # mirrors calamares/locale.conf
    if [ -f /etc/timezone ]; then
        current_tz="$(cat /etc/timezone 2>/dev/null || true)"
    fi
    if [ -n "$current_tz" ] && [ -e "/usr/share/zoneinfo/$current_tz" ]; then
        guess_default="$current_tz"
    fi

    if [ "$UI_MODE" = "tui" ]; then
        local args=() tz
        while IFS= read -r tz; do
            [ -z "$tz" ] && continue
            args+=("$tz" "$tz")
        done < <(read_timezones)
        # Add a "Custom..." option
        args+=("__custom__" "Custom (type any IANA timezone)")
        tui_menu "Timezone" "Pick a timezone (default: $guess_default)" "$guess_default" "${args[@]}"
        if [ "$REPLY" = "__custom__" ]; then
            tui_input "Custom timezone" "Enter an IANA timezone (e.g. Asia/Tokyo):" "$guess_default"
            TIMEZONE="$REPLY"
        else
            TIMEZONE="$REPLY"
        fi
    else
        info "Common timezones:"
        local lines=() line tz
        while IFS= read -r tz; do
            [ -z "$tz" ] && continue
            lines+=("$tz")
        done < <(read_timezones)
        local i=1
        while IFS= read -r tz; do
            [ -z "$tz" ] && continue
            printf '  %3d) %s\n' "$i" "$tz"
            i=$((i+1))
        done < <(read_timezones)
        printf '  %3d) %s\n' "$i" "Custom (type any IANA timezone)"
        text_input "Choose a timezone by number" "1"
        if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le "${#lines[@]}" ]; then
            TIMEZONE="${lines[$((REPLY-1))]}"
        else
            text_input "Enter an IANA timezone" "$guess_default"
            TIMEZONE="$REPLY"
        fi
    fi

    # Validate
    if [ ! -e "/usr/share/zoneinfo/$TIMEZONE" ]; then
        warn "Unknown timezone '$TIMEZONE' — falling back to UTC."
        TIMEZONE="UTC"
    fi
    ok "Timezone: $TIMEZONE"
}

# -----------------------------------------------------------------------------
# STEP: disk target
# -----------------------------------------------------------------------------
list_block_devices() {
    # Echo "<dev>\t<size>\t<model>" lines, skipping loop/ram/zram/dm-.*.
    lsblk -bdno NAME,SIZE,MODEL,TYPE 2>/dev/null \
        | awk '$4 == "disk" { printf "/dev/%s\t%s\t%s\n", $1, $2, $3 }'
}

step_disk() {
    step "Disk"
    hr
    info "Choose how to partition the target disk."

    if [ "$UI_MODE" = "tui" ]; then
        tui_yesno "Erase disk" "Erase the entire disk and let the installer partition it?\n\nChoose No to drop into cfdisk for manual partitioning (advanced)."
        DISK_MODE="erase"
        [ "$REPLY" = "n" ] && DISK_MODE="manual"
    else
        text_yesno "Erase the entire disk and let the installer partition it?\n(Choose 'n' to use manual partition mode.)" "y"
        [ "$REPLY" = "y" ] && DISK_MODE="erase" || DISK_MODE="manual"
    fi

    # List candidate disks
    local devmap
    devmap="$(mktemp)"
    list_block_devices > "$devmap"
    if [ ! -s "$devmap" ]; then
        rm -f "$devmap"
        die "No candidate block devices found."
    fi

    if [ "$UI_MODE" = "tui" ]; then
        local args=() dev size model
        while IFS=$'\t' read -r dev size model; do
            [ -z "$dev" ] && continue
            local human
            human="$(numfmt --to=iec --suffix=B "$size" 2>/dev/null || echo "$size")"
            args+=("$dev" "$human — $model")
        done < "$devmap"
        tui_menu "Target disk" "Pick the disk to install onto" "${args[0]}" "${args[@]}"
        DISK_TARGET="$REPLY"
    else
        info "Available disks:"
        local lines=() line dev size model
        while IFS=$'\t' read -r dev size model; do
            [ -z "$dev" ] && continue
            lines+=("$dev")
            local human
            human="$(numfmt --to=iec --suffix=B "$size" 2>/dev/null || echo "$size")"
            printf '  %d) %s  (%s — %s)\n' "${#lines[@]}" "$dev" "$human" "$model"
        done < "$devmap"
        text_input "Choose a disk by number" "1"
        if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le "${#lines[@]}" ]; then
            DISK_TARGET="${lines[$((REPLY-1))]}"
        else
            die "Invalid disk selection."
        fi
    fi
    rm -f "$devmap"

    # Confirm destructive action
    if [ "$DISK_MODE" = "erase" ]; then
        if [ "$UI_MODE" = "tui" ]; then
            tui_yesno "Confirm erase" "ALL DATA on $DISK_TARGET will be destroyed.\n\nProceed?"
        else
            text_yesno "ALL DATA on $DISK_TARGET will be destroyed. Proceed?" "n"
        fi
        [ "$REPLY" = "y" ] || die "Aborted by user before partitioning."
    else
        if [ "$UI_MODE" = "tui" ]; then
            tui_msg "Manual partition" "You will be dropped into cfdisk on $DISK_TARGET.\n\nCreate at minimum:\n  • A 512 MiB EFI System Partition (type EFI)\n  • A root partition (type Linux filesystem)\n  • Optionally a swap partition\n\nWhen you exit cfdisk (Write → Quit), the installer will continue."
        else
            info "You will be dropped into cfdisk on $DISK_TARGET."
            info "Create at minimum:"
            info "  - A 512 MiB EFI System Partition (type EFI)"
            info "  - A root partition (type Linux filesystem)"
            info "  - Optionally a swap partition"
            info "When you exit cfdisk (Write → Quit), the installer will continue."
        fi
    fi
    ok "Target disk: $DISK_TARGET ($DISK_MODE mode)"
}

# -----------------------------------------------------------------------------
# STEP: user account
# -----------------------------------------------------------------------------
validate_username() {
    local u="$1"
    [[ "$u" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || return 1
    case "$u" in
        root|daemon|bin|sys|sync|games|man|lp|mail|news|uucp|proxy|www-data|backup|list|irc|nobody|_apt|systemd-*|messagebus|sshd) return 1 ;;
    esac
    return 0
}

step_user() {
    step "User account"
    hr

    # Full name
    ui_input "Full name" "Enter the real name for the new user (or leave empty to skip)" ""
    FULLNAME="$REPLY"

    # Username
    while :; do
        ui_input "Username" "Enter a username (lowercase, starts with a letter)" "user"
        USERNAME="$REPLY"
        if validate_username "$USERNAME"; then break; fi
        warn "Invalid username '$USERNAME'. Use lowercase letters/digits/'_'/'-', max 32 chars, not 'root' or system names."
    done

    # Password (twice)
    while :; do
        ui_password "Password" "Enter a password for $USERNAME (min 8 chars)"
        PASSWORD="$REPLY"
        if [ "${#PASSWORD}" -lt 8 ]; then
            warn "Password must be at least 8 characters. Try again."
            continue
        fi
        ui_password "Confirm password" "Re-enter the password to confirm"
        if [ "$REPLY" = "$PASSWORD" ]; then break; fi
        warn "Passwords do not match. Try again."
    done

    # Hostname
    while :; do
        ui_input "Hostname" "Enter a hostname for this machine" "ubuntu"
        HOSTNAME="$REPLY"
        [[ "$HOSTNAME" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]] || { warn "Invalid hostname."; continue; }
        break
    done

    ok "User: $FULLNAME ($USERNAME) on $HOSTNAME"
}

# -----------------------------------------------------------------------------
# STEP: summary
# -----------------------------------------------------------------------------
step_summary() {
    step "Summary"
    hr
    local summary
    summary="$(cat <<EOF
Locale         : $LOCALE
Keyboard       : $KEYBOARD_LAYOUT${KEYBOARD_VARIANT:+ ($KEYBOARD_VARIANT)}
Timezone       : $TIMEZONE

Installation type : ${DISK_MODE}
Target disk       : ${DISK_TARGET}

User:
  Full name : $FULLNAME
  Username  : $USERNAME
  Hostname  : $HOSTNAME

A reboot will be issued after installation completes.
EOF
)"
    if [ "$UI_MODE" = "tui" ]; then
        tui_msg "Summary" "$summary"
    else
        printf '%s\n' "$summary"
    fi

    ui_yesno "Proceed with installation?" "n"
    [ "$REPLY" = "y" ] || die "Aborted by user at the summary step."
}

# -----------------------------------------------------------------------------
# PARTITIONING (Calmares 'partition' module equivalent)
# -----------------------------------------------------------------------------
partition_erase() {
    local dev="$1"
    info "Wiping $dev and creating a fresh GPT layout (512 MiB ESP + 4 GiB swap + root)."

    # Zero out any existing partition table magic.
    wipefs -af "$dev" >/dev/null 2>&1 || true
    sgdisk --zap-all "$dev" >/dev/null

    # Create partitions (Calamares partition.conf layout, no LUKS):
    #   1) 512 MiB  EFI System  (type 1, /boot/efi)
    #   2) 4 GiB    swap        (type 19)
    #   3) remainder root (/)   (type 20)
    sgdisk -n1:0:+512M -t1:EF00 -c1:"EFI System" "$dev" >/dev/null
    sgdisk -n2:0:+4G   -t2:8200 -c2:"swap"        "$dev" >/dev/null
    sgdisk -n3:0:0    -t3:8300 -c3:"root"         "$dev" >/dev/null
    partprobe "$dev" >/dev/null 2>&1 || true
    sleep 1
    udevadm settle >/dev/null 2>&1 || true

    # Resolve partition names (handles /dev/nvme0n1p1 vs /dev/sda1).
    if [[ "$dev" =~ (nvme|mmcblk) ]]; then
        EFI_PART="${dev}p1"
        SWAP_PART="${dev}p2"
        ROOT_PART="${dev}p3"
    else
        EFI_PART="${dev}1"
        SWAP_PART="${dev}2"
        ROOT_PART="${dev}3"
    fi
    [ -b "$EFI_PART" ]  || die "EFI partition $EFI_PART not found after partitioning."
    [ -b "$SWAP_PART" ] || die "Swap partition $SWAP_PART not found after partitioning."
    [ -b "$ROOT_PART" ] || die "Root partition $ROOT_PART not found after partitioning."

    info "Formatting EFI ($EFI_PART) as FAT32..."
    mkfs.fat -F32 -n EFI "$EFI_PART" >/dev/null
    info "Formatting swap ($SWAP_PART)..."
    mkswap -L swap "$SWAP_PART" >/dev/null
    info "Formatting root ($ROOT_PART) as ext4..."
    mkfs.ext4 -F -L root "$ROOT_PART" >/dev/null
}

partition_manual() {
    local dev="$1"
    info "Launching cfdisk on $dev. Create at minimum: an ESP, root, and (optionally) swap."
    if ! command -v cfdisk >/dev/null 2>&1; then
        die "cfdisk is not installed; cannot run manual partitioning."
    fi
    cfdisk "$dev" || true
    partprobe "$dev" >/dev/null 2>&1 || true
    sleep 1
    udevadm settle >/dev/null 2>&1 || true

    # Heuristically identify the partitions by FS type/label.
    local parts=()
    mapfile -t parts < <(lsblk -lnpo NAME,TYPE "$dev" | awk '$2 == "part" { print $1 }')
    [ "${#parts[@]}" -ge 2 ] || die "Expected at least 2 partitions on $dev after manual partitioning."

    EFI_PART=""
    SWAP_PART=""
    ROOT_PART=""
    for p in "${parts[@]}"; do
        local fstype
        fstype="$(blkid -s TYPE -o value "$p" 2>/dev/null || true)"
        case "$fstype" in
            vfat) EFI_PART="$p" ;;
            swap)  SWAP_PART="$p" ;;
            ext4|btrfs|xfs) ROOT_PART="$p" ;;
        esac
    done

    # If the user didn't add a swap, prompt for whether to skip or use a swap file.
    if [ -z "$SWAP_PART" ]; then
        if [ "$UI_MODE" = "tui" ]; then
            tui_yesno "Swap" "No swap partition detected. Use a swap file on the root filesystem instead?"
        else
            text_yesno "No swap partition detected. Use a swap file on the root filesystem instead?" "n"
        fi
        SWAP_FILE_CREATE=$([ "$REPLY" = "y" ] && echo 1 || echo 0)
    else
        SWAP_FILE_CREATE=0
    fi

    [ -n "$EFI_PART" ]  || die "Could not find an EFI System Partition (vfat) on $dev."
    [ -n "$ROOT_PART" ] || die "Could not find a root partition (ext4/btrfs/xfs) on $dev."
    if [ -z "$SWAP_PART" ] && [ "$SWAP_FILE_CREATE" -eq 0 ]; then
        warn "No swap and no swap file — continuing without swap."
    fi
}

# -----------------------------------------------------------------------------
# INSTALL (Calmares 'exec' sequence: mount → unpackfs → ... → umount)
# -----------------------------------------------------------------------------
mount_target() {
    info "Mounting target filesystems under $TARGET_ROOT."
    mkdir -p "$TARGET_ROOT"
    mount "$ROOT_PART" "$TARGET_ROOT"
    MOUNT_POINTS+=("$TARGET_ROOT")
    mkdir -p "$TARGET_ROOT/boot/efi"
    mount "$EFI_PART" "$TARGET_ROOT/boot/efi"
    MOUNT_POINTS+=("$TARGET_ROOT/boot/efi")
    if [ -n "$SWAP_PART" ]; then
        swapon "$SWAP_PART" || warn "swapon $SWAP_PART failed — continuing."
    fi
    # Live-bind the bits Calamares' mount.conf binds (proc/sys/dev/run/...).
    mount -t proc  proc  "$TARGET_ROOT/proc";  MOUNT_POINTS+=("$TARGET_ROOT/proc")
    mount -t sysfs sysfs "$TARGET_ROOT/sys";  MOUNT_POINTS+=("$TARGET_ROOT/sys")
    mount --bind /dev "$TARGET_ROOT/dev";     MOUNT_POINTS+=("$TARGET_ROOT/dev")
    mount -t tmpfs tmpfs "$TARGET_ROOT/run";  MOUNT_POINTS+=("$TARGET_ROOT/run")
    mount --bind /run/udev "$TARGET_ROOT/run/udev" 2>/dev/null || true
    if [ -d /sys/firmware/efi ]; then
        mount -t efivarfs efivarfs "$TARGET_ROOT/sys/firmware/efi/efivars" 2>/dev/null || true
    fi
    mount --bind /run/systemd/resolve "$TARGET_ROOT/run/systemd/resolve" 2>/dev/null || true
}

unpack_target() {
    info "Unpacking live squashfs into $TARGET_ROOT (this can take several minutes)..."
    if command -v unsquashfs >/dev/null 2>&1; then
        unsquashfs -d "$TARGET_ROOT" -f "$LIVE_SQUASHFS"
    else
        # Fallback: mount the squashfs and rsync.
        local tmp_mnt
        tmp_mnt="$(mktemp -d)"
        mount -t squashfs -o loop "$LIVE_SQUASHFS" "$tmp_mnt"
        rsync -aHAX --numeric-ids "$tmp_mnt"/ "$TARGET_ROOT"/
        umount "$tmp_mnt"
        rmdir "$tmp_mnt"
    fi
    ok "Live filesystem unpacked."
}

# Workaround for LP#1829805 (initramfs skipped on first run if /boot/initrd.img-*
# is missing in the target). Runs inside the chroot.
chroot_initramfs_touch() {
    info "Workaround for LP#1829805: touching /boot/initrd.img-$(uname -r)."
    chroot "$TARGET_ROOT" /bin/bash -c "touch /boot/initrd.img-$(uname -r)"
}

run_in_chroot() {
    chroot "$TARGET_ROOT" /bin/bash -c "$1"
}

# Equivalent of calamares 'machineid' (with dbus symlink).
configure_machineid() {
    info "Generating /etc/machine-id in target."
    systemd-machine-id-setup --root="$TARGET_ROOT" >/dev/null 2>&1 \
        || chroot "$TARGET_ROOT" /bin/bash -c "systemd-machine-id-setup"
    run_in_chroot "dbus-uuidgen --ensure=/etc/machine-id"
}

# Equivalent of calamares 'fstab' — UUID-based.
configure_fstab() {
    info "Writing /etc/fstab (UUID-based)."
    local fstab="$TARGET_ROOT/etc/fstab"
    {
        printf '# /etc/fstab — generated by ubuntu-cli-installer\n'
        printf '# <device>\t<dir>\t<type>\t<options>\t<dump>\t<pass>\n'
        if [ -n "$EFI_PART" ]; then
            local efi_uuid
            efi_uuid="$(blkid -s UUID -o value "$EFI_PART")"
            printf 'UUID=%s\t/boot/efi\tvfat\tumask=0077\t0\t2\n' "$efi_uuid"
        fi
        if [ -n "$ROOT_PART" ]; then
            local root_uuid
            root_uuid="$(blkid -s UUID -o value "$ROOT_PART")"
            printf 'UUID=%s\t/\t%s\tdefaults\t0\t1\n' "$root_uuid" "$(blkid -s TYPE -o value "$ROOT_PART")"
        fi
        if [ -n "$SWAP_PART" ]; then
            local swap_uuid
            swap_uuid="$(blkid -s UUID -o value "$SWAP_PART")"
            printf 'UUID=%s\tnone\tswap\tsw\t0\t0\n' "$swap_uuid"
        fi
    } > "$fstab"
}

configure_locale() {
    info "Generating locale $LOCALE in the target."
    # Mirrors calamares/localecfg + locale.conf.
    echo "$LOCALE UTF-8" >> "$TARGET_ROOT/etc/locale.gen"
    run_in_chroot "locale-gen $LOCALE"
    run_in_chroot "update-locale LANG=$LOCALE"
    echo "LANG=$LOCALE" > "$TARGET_ROOT/etc/default/locale"
    # Timezone (hwclock in calamares is set later, but storing here is safe).
    run_in_chroot "ln -sf /usr/share/zoneinfo/$TIMEZONE /etc/localtime"
    run_in_chroot "dpkg-reconfigure -f noninteractive tzdata"
}

configure_keyboard() {
    info "Configuring keyboard layout in target ($KEYBOARD_LAYOUT)."
    cat > "$TARGET_ROOT/etc/default/keyboard" <<EOF
# Generated by ubuntu-cli-installer
XKBLAYOUT="$KEYBOARD_LAYOUT"
XKBVARIANT="$KEYBOARD_VARIANT"
XKBOPTIONS=""
BACKSPACE="guess"
EOF
    run_in_chroot "dpkg-reconfigure -f noninteractive keyboard-configuration || true"
    run_in_chroot "setupcon -k 2>/dev/null || true"
}

# Equivalent of calamares 'users' module (doAutologin=false, setRootPassword=false,
# sudoersGroup=sudo, defaultGroups=adm,cdrom,dip,lpadmin,plugdev,sudo,
# passwordRequirements: minLength 8, user.shell=/bin/bash, forbidden=root).
create_user() {
    info "Creating user $USERNAME with home directory, default groups, and sudoers."
    run_in_chroot "useradd -m -s /bin/bash -c $(printf %q "$FULLNAME") $USERNAME"
    run_in_chroot "echo '$USERNAME:$PASSWORD' | chpasswd"
    for g in adm cdrom dip lpadmin plugdev sudo; do
        run_in_chroot "usermod -aG $g $USERNAME" || true
    done
    # Sudoers NOPASSWD is intentionally NOT set — matches Calamares' default
    # (password is required for sudo).
}

# Equivalent of calamares 'displaymanager' (autodetect gdm3/lightdm/sddm).
configure_displaymanager() {
    info "Configuring display manager (autodetect)."
    chroot "$TARGET_ROOT" /bin/bash -c '
        set -e
        for dm in gdm3 lightdm sddm; do
            if dpkg -s "$dm" >/dev/null 2>&1; then
                echo "Found DM: $dm — re-enabling."
                systemctl --root=/ enable "$dm" >/dev/null 2>&1 || true
            fi
        done
    '
}

# Equivalent of calamares 'networkcfg' (debian: write /etc/network/interfaces for
# loopback only — most desktop installs use NetworkManager from the chosen DE).
configure_network() {
    info "Writing minimal /etc/network/interfaces (loopback only)."
    cat > "$TARGET_ROOT/etc/network/interfaces" <<'EOF'
# Generated by ubuntu-cli-installer — NetworkManager manages the rest.
auto lo
iface lo inet loopback
EOF
}

# Equivalent of calamares 'hwclock' (set UTC hardware clock).
configure_hwclock() {
    info "Setting hardware clock to UTC."
    run_in_chroot "hwclock --systohc --utc" || warn "hwclock failed — continuing."
}

# Equivalent of calamares 'initramfscfg' + 'initramfs'.
configure_initramfs() {
    info "Regenerating initramfs for all installed kernels."
    chroot "$TARGET_ROOT" /bin/bash -c '
        set -e
        if command -v update-initramfs >/dev/null 2>&1; then
            for img in /boot/vmlinuz-*; do
                [ -e "$img" ] || continue
                ver="${img##*/vmlinuz-}"
                update-initramfs -c -k "$ver" || true
            done
        elif command -v dracut >/dev/null 2>&1; then
            dracut --regenerate-all --force
        fi
    '
}

# Equivalent of calamares 'grubcfg' (defaults + GRUB_ENABLE_CRYPTODISK=true).
configure_grubcfg() {
    info "Writing /etc/default/grub (GRUB_ENABLE_CRYPTODISK=true)."
    cat > "$TARGET_ROOT/etc/default/grub" <<'EOF'
# Generated by ubuntu-cli-installer.
GRUB_DEFAULT=0
GRUB_TIMEOUT_STYLE=menu
GRUB_TIMEOUT=10
GRUB_DISTRIBUTOR=`lsb_release -i -s 2>/dev/null || echo Ubuntu`
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""
GRUB_ENABLE_CRYPTODISK=true
EOF
}

# Equivalent of calamares 'bootloader' (grub-install, target=x86_64-efi + i386-pc).
install_bootloader() {
    info "Installing GRUB to $DISK_TARGET (UEFI + legacy BIOS for hybrid)."

    if [ -d /sys/firmware/efi ]; then
        chroot "$TARGET_ROOT" /bin/bash -c "
            set -e
            grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=ubuntu --recheck
        "
    else
        chroot "$TARGET_ROOT" /bin/bash -c "
            set -e
            grub-install --target=i386-pc $DISK_TARGET
        "
    fi

    # Install for the other target as well if the disk is GPT (hybrid) — matches
    # the hybrid UEFI+BIOS boot of the live ISO.
    if [ -d /sys/firmware/efi ] && command -v grub-install >/dev/null 2>&1; then
        chroot "$TARGET_ROOT" /bin/bash -c "
            grub-install --target=i386-pc $DISK_TARGET
        " 2>/dev/null || true
    fi

    run_in_chroot "grub-mkconfig -o /boot/grub/grub.cfg"
}

# Equivalent of calamares 'packages' (strip live-only packages; try_install
# language packs for the chosen locale).
strip_live_packages() {
    info "Removing live-only packages from the target."
    chroot "$TARGET_ROOT" /bin/bash -c '
        set -e
        export DEBIAN_FRONTEND=noninteractive
        apt-get -y purge \
            calamares \
            casper \
            cifs-utils \
            discover \
            laptop-detect \
            os-prober 2>/dev/null || true
        apt-get -y autoremove --purge || true
    '
    info "Installing language packs for $LOCALE (best-effort, online only)."
    local short="${LOCALE%.*}"     # en_US.UTF-8 → en_US
    local lang="${short%_*}"       # en_US → en
    chroot "$TARGET_ROOT" /bin/bash -c "
        set -e
        export DEBIAN_FRONTEND=noninteractive
        for pkg in language-pack-$short hunspell-$short libreoffice-help-$short libreoffice-l10n-$short; do
            apt-get install -y --no-install-recommends \"\$pkg\" 2>/dev/null || true
        done
    " || true
}

umount_target() {
    info "Unmounting target filesystems."
    # Order matters: deepest first.
    swapoff "$SWAP_PART" 2>/dev/null || true
    for (( idx=${#MOUNT_POINTS[@]}-1 ; idx>=0 ; idx-- )); do
        local mp="${MOUNT_POINTS[$idx]}"
        if mountpoint -q "$mp" 2>/dev/null; then
            umount "$mp" 2>/dev/null || umount -l "$mp" 2>/dev/null || warn "Could not unmount $mp."
        fi
    done
    MOUNT_POINTS=()
    [ -d "$TARGET_ROOT" ] && rmdir "$TARGET_ROOT" 2>/dev/null || true
}

run_installation() {
    step "Installation"
    hr

    if [ "$DISK_MODE" = "erase" ]; then
        partition_erase "$DISK_TARGET"
    else
        partition_manual "$DISK_TARGET"
    fi

    mount_target
    unpack_target
    configure_machineid
    configure_fstab
    configure_locale
    configure_keyboard
    chroot_initramfs_touch
    create_user
    configure_displaymanager
    configure_network
    configure_hwclock
    configure_initramfs
    configure_grubcfg
    install_bootloader
    strip_live_packages
    umount_target

    ok "Installation complete."
}

# -----------------------------------------------------------------------------
# STEP: finished
# -----------------------------------------------------------------------------
step_finished() {
    step "Finished"
    banner "Installation complete — rebooting now"
    info "The system has been installed on $DISK_TARGET."
    info "Removing the live USB and rebooting into the new system..."
    sync
    # Reboot into the new system (Calamares uses 'systemctl -i reboot').
    sleep 3
    systemctl -i reboot || reboot
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------
main() {
    require_root
    check_live_env
    step_welcome
    step_locale
    step_keyboard
    step_timezone
    step_disk
    step_user
    step_summary
    run_installation
    step_finished
}

main "$@"
