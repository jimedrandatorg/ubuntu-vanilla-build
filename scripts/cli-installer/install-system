# -----------------------------------------------------------------------------
# Output helpers
# -----------------------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RESET=$'\033[0m'
    C_BOLD=$'\033[1m'
    C_DIM=$'\033[2m'
    C_RED=$'\033[31m'
    C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m'
    C_BLUE=$'\033[34m'
    C_MAGENTA=$'\033[35m'
    C_CYAN=$'\033[36m'
else
    C_RESET=""; C_BOLD=""; C_DIM=""; C_RED=""
    C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_MAGENTA=""; C_CYAN=""
fi

log()   { printf '%s==>%s %s\n' "$C_BLUE$C_BOLD" "$C_RESET$C_BOLD" "$*$C_RESET"; }
info()  { printf '%s[i]%s %s\n' "$C_CYAN" "$C_RESET" "$*"; }
ok()    { printf '%s[+]%s %s\n' "$C_GREEN$C_BOLD" "$C_RESET$C_BOLD" "$*$C_RESET"; }
warn()  { printf '%s[!]%s %s\n' "$C_YELLOW$C_BOLD" "$C_RESET" "$*$C_BOLD" >&2; }
err()   { printf '%s[x]%s %s\n' "$C_RED$C_BOLD" "$C_RESET" "$*$C_BOLD" >&2; }
step()  { printf '\n%s── %s ──%s\n' "$C_MAGENTA$C_BOLD" "$*" "$C_RESET"; }
hr()    { printf '%s%s%s\n' "$C_DIM" "$(printf '─%.0s' {1..70})" "$C_RESET"; }
banner() {
    printf '%s%s\n' "$C_BOLD" "================================================================"
    printf '  %s\n' "$*"
    printf '%s%s\n' "================================================================" "$C_RESET"
}

die() {
    err "$*"
    cleanup_mounts
    exit 1
}

trap 'on_interrupt' INT TERM
on_interrupt() {
    err "Interrupted. Unmounting target and aborting."
    cleanup_mounts
    exit 130
}

cleanup_mounts() {
    # Tear down in reverse order, ignore errors.
    local mp
    for (( idx=${#MOUNT_POINTS[@]}-1 ; idx>=0 ; idx-- )); do
        mp="${MOUNT_POINTS[$idx]}"
        [ -n "$mp" ] || continue
        if mountpoint -q "$mp" 2>/dev/null; then
            umount "$mp" 2>/dev/null || umount -l "$mp" 2>/dev/null || true
        fi
    done
    # Deactivate any swap we may have activated on the target.
    [ -n "$SWAP_PART" ] && swapoff "$SWAP_PART" 2>/dev/null || true
    [ -d "$TARGET_ROOT" ] && rmdir "$TARGET_ROOT" 2>/dev/null || true
}

# -----------------------------------------------------------------------------
# Prompt helpers (text mode)
# -----------------------------------------------------------------------------
text_input() {
    # text_input <prompt> [<default>]
    local prompt="$1" default="${2:-}" value=""
    if [ -n "$default" ]; then
        printf '%s%s%s [%s]: ' "$C_BOLD" "$prompt" "$C_RESET" "$default"
    else
        printf '%s%s%s: ' "$C_BOLD" "$prompt" "$C_RESET"
    fi
    IFS= read -r value
    if [ -z "$value" ] && [ -n "$default" ]; then
        printf '%s\n' "$default"
        REPLY="$default"
    else
        REPLY="$value"
    fi
}

text_password() {
    # text_password <prompt> — set REPLY
    local prompt="$1" first="" second=""
    while :; do
        printf '%s%s%s: ' "$C_BOLD" "$prompt" "$C_RESET"
        IFS= read -rs first || true
        printf '\n'
        printf '%sConfirm %s%s: ' "$C_BOLD" "$prompt" "$C_RESET"
        IFS= read -rs second || true
        printf '\n'
        if [ "$first" != "$second" ]; then
            warn "Passwords do not match. Try again."
            continue
        fi
        if [ -z "$first" ]; then
            warn "Password cannot be empty. Try again."
            continue
        fi
        if [ "${#first}" -lt 8 ]; then
            warn "Password must be at least 8 characters. Try again."
            continue
        fi
        REPLY="$first"
        return 0
    done
}

text_yesno() {
    # text_yesno <prompt> [<default y|n>] — sets REPLY to y or n
    local prompt="$1" default="${2:-}" ans="" suffix=""
    if [ "$default" = "y" ]; then suffix=" [Y/n]"
    elif [ "$default" = "n" ]; then suffix=" [y/N]"
    else suffix=" [y/n]"; fi
    while :; do
        printf '%s%s%s%s: ' "$C_BOLD" "$prompt" "$C_RESET" "$suffix"
        IFS= read -r ans
        ans="${ans:-$default}"
        case "$ans" in
            y|Y|yes|YES) REPLY="y"; return 0 ;;
            n|N|no|NO)   REPLY="n"; return 0 ;;
            *) warn "Please answer y or n." ;;
        esac
    done
}

text_choice() {
    # text_choice <prompt> <default_index(1-based)> <choice>... — sets REPLY
    local prompt="$1" default="$2"; shift 2
    local i=1 choice
    hr
    printf '%s%s%s\n' "$C_BOLD" "$prompt" "$C_RESET"
    for choice in "$@"; do
        if [ "$i" -eq "$default" ]; then
            printf '  %s>%s %d) %s\n' "$C_GREEN$C_BOLD" "$C_RESET" "$i" "$choice"
        else
            printf '    %d) %s\n' "$i" "$choice"
        fi
        i=$((i+1))
    done
    hr
    local ans
    while :; do
        printf 'Select [1-%d] (default %d): ' "$(($#))" "$default"
        IFS= read -r ans
        ans="${ans:-$default}"
        if [[ "$ans" =~ ^[0-9]+$ ]] && [ "$ans" -ge 1 ] && [ "$ans" -le $# ]; then
            REPLY="${!ans}"
            return 0
        fi
        warn "Invalid choice: $ans"
    done
}

# -----------------------------------------------------------------------------
# Prompt helpers (TUI mode — whiptail, fall back to dialog)
# -----------------------------------------------------------------------------
have_whiptail() { command -v whiptail >/dev/null 2>&1; }
have_dialog()  { command -v dialog  >/dev/null 2>&1; }

tui_msg() {
    # tui_msg <title> <message>
    local title="$1" msg="$2"
    if have_whiptail; then
        whiptail --title "$title" --msgbox "$msg" 16 72
    else
        dialog --title "$title" --msgbox "$msg" 16 72
    fi
}

tui_yesno() {
    # tui_yesno <title> <text> [<default 0|1>] — sets REPLY to 0 (yes) or 1 (no)
    local title="$1" text="$2" default="${3:-0}"
    local rc
    if have_whiptail; then
        whiptail --title "$title" --yesno "$text" 12 72 --defaultno
        # whiptail does not honour --defaultno vs --default-yes; emulate via default param.
        rc=$?
    else
        dialog --title "$title" --yesno "$text" 12 72
        rc=$?
    fi
    if [ "$rc" -eq 0 ]; then REPLY="y"; else REPLY="n"; fi
}

tui_input() {
    # tui_input <title> <text> <default> — sets REPLY
    local title="$1" text="$2" default="${3:-}" rc
    if have_whiptail; then
        REPLY="$(whiptail --title "$title" --inputbox "$text" 10 72 "$default" 3>&1 1>&2 2>&3)" || true
    else
        REPLY="$(dialog --title "$title" --inputbox "$text" 10 72 "$default" 3>&1 1>&2 2>&3)" || true
    fi
    [ -z "$REPLY" ] && REPLY="$default"
}

tui_password() {
    # tui_password <title> <text> — sets REPLY
    local title="$1" text="$2" rc
    if have_whiptail; then
        REPLY="$(whiptail --title "$title" --passwordbox "$text" 10 72 3>&1 1>&2 2>&3)" || true
    else
        REPLY="$(dialog --title "$title" --passwordbox "$text" 10 72 3>&1 1>&2 2>&3)" || true
    fi
}

tui_menu() {
    # tui_menu <title> <text> <default_tag> <choice_tag> <choice_text>...
    # sets REPLY to the chosen tag.
    local title="$1" text="$2" default="$3"; shift 3
    local rc
    if have_whiptail; then
        REPLY="$(whiptail --title "$title" --menu "$text" 20 72 12 "$@" --default-item "$default" 3>&1 1>&2 2>&3)" || true
    else
        REPLY="$(dialog --title "$title" --menu "$text" 20 72 12 "$@" 3>&1 1>&2 2>&3)" || true
    fi
}

# -----------------------------------------------------------------------------
# Mode-aware wrappers
# -----------------------------------------------------------------------------
ui_msg()      { [ "$UI_MODE" = "tui" ] && tui_msg      "$@" || { local t="$1"; shift; printf '%s%s%s\n\n' "$C_BOLD" "$t" "$C_RESET"; printf '%s\n' "$*"; printf 'Press Enter to continue... '; IFS= read -r _; }; }
ui_yesno()    { if [ "$UI_MODE" = "tui" ]; then tui_yesno  "$@"; else local t="$1" m="$2" d="${3:-}"; text_yesno "$m" "$d"; fi }
ui_input()    { if [ "$UI_MODE" = "tui" ]; then tui_input  "$@"; else local t="$1" m="$2" d="${3:-}"; text_input "$m" "$d"; fi }
ui_password() { if [ "$UI_MODE" = "tui" ]; then tui_password "$@"; else local t="$1" m="$2"; text_password "$m"; fi }
ui_menu()     { if [ "$UI_MODE" = "tui" ]; then tui_menu "$@"; else local t="$1" m="$2" d="$3"; shift 3; text_choice "$m" "$d" "$@"; fi }

# -----------------------------------------------------------------------------
# Pre-flight
# -----------------------------------------------------------------------------
require_root() {
    if [ "$(id -u)" -ne 0 ]; then
        die "This installer must be run as root (try: sudo $SCRIPT_NAME)."
    fi
}

check_live_env() {
    if [ ! -f "$LIVE_SQUASHFS" ]; then
        die "Live squashfs not found at $LIVE_SQUASHFS.
This installer must be run from the Ubuntu Vanilla Build live ISO.
If you booted a minimal/server ISO, use debootstrap instead."
    fi
    if ! [ -d "$LIVE_CDROM" ]; then
        die "Live CD mountpoint $LIVE_CDROM not found. Are you running on the live ISO?"
    fi
}

# -----------------------------------------------------------------------------
# STEP: welcome
# -----------------------------------------------------------------------------
step_welcome() {
    banner "Welcome to the Ubuntu CLI Installer"
    info "This installer copies the live system to your disk and configures"
    info "users, locale, timezone, keyboard, GRUB, and packages."
    info "It is fully interactive — every step asks before doing anything."
    info "It only supports the 'Erase disk' and 'Manual partition' modes."
    info "No LUKS encryption is offered in this version."
    hr

    if have_whiptail || have_dialog; then
        text_choice "Choose the user interface:" 1 \
            "TUI (whiptail/dialog boxes — recommended)" \
            "Plain text prompts"
        case "$REPLY" in
            *TUI*|*whiptail*) UI_MODE="tui" ;;
            *)                  UI_MODE="text" ;;
        esac
    else
        UI_MODE="text"
        info "No whiptail/dialog detected — using plain text prompts."
    fi

    if [ "$UI_MODE" = "tui" ]; then
        ui_msg "Welcome" "Welcome to the Ubuntu CLI Installer.\n\nThe installer will guide you through:\n  1. Locale & keyboard\n  2. Timezone\n  3. Disk target\n  4. User account\n  5. Installation\n  6. Reboot\n\nPress OK to continue."
    else
        ui_yesno "Start the installation now?" "y"
        [ "$REPLY" = "y" ] || die "Aborted by user at welcome screen."
    fi
}

# -----------------------------------------------------------------------------
# STEP: locale
# -----------------------------------------------------------------------------
read_i18n_entries() {
    # Echo "<locale>\t<pretty>" lines from the embedded SUPPORTED_LOCALES.
    # The list is baked into the top of this script so it works from any
    # install path without depending on the project tree being on disk.
    # Each line in SUPPORTED_LOCALES is "<locale> UTF-8"; we keep UTF-8 only.
    awk 'NF>=2 && $2 ~ /UTF-8/ { printf "%s\t%s\n", $1, $1 }' <<<"$SUPPORTED_LOCALES"
}

step_locale() {
    step "Locale"
    hr
    info "Choose your locale. Default if you press Enter: en_US.UTF-8"
    info "Tip: enter the language code (e.g. 'de_DE' or 'fr_FR') to filter."

    local map_file
    map_file="$(mktemp)"
    read_i18n_entries > "$map_file"

    # Default choice is en_US.UTF-8
    local default_locale="en_US.UTF-8"

    if [ "$UI_MODE" = "tui" ]; then
        # Build a whiptail menu of all locales (up to ~120 entries is fine for
        # the curated list; the upstream SUPPORTED is filtered to UTF-8 only).
        local args=()
        while IFS=$'\t' read -r tag pretty; do
            [ -z "$tag" ] && continue
            args+=("$tag" "$pretty")
        done < "$map_file"
        # whiptail menu caps at ~250 items — our curated list is ~95.
        tui_menu "Locale" "Pick your locale (default: en_US.UTF-8)" "$default_locale" "${args[@]}"
        LANG_CHOICE="$REPLY"
    else
        local filter="" filtered
        while :; do
            text_input "Filter (Enter for full list, or en_US, de_DE, fr_FR, etc.)" ""
            filter="$REPLY"
            if [ -z "$filter" ]; then
                filtered="$(cat "$map_file")"
            else
                filtered="$(grep -i "$filter" "$map_file" || true)"
            fi
            if [ -z "$filtered" ]; then
                warn "No locales matched '$filter' — try again."
                continue
            fi
            local lines=() line tag pretty
            while IFS= read -r line; do
                tag="${line%%	*}"
                lines+=("$tag")
            done <<< "$filtered"
            # Show a numbered list and ask the user to pick by index.
            info "Matching locales:"
            local i=1
            while IFS=$'\t' read -r tag pretty; do
                [ -z "$tag" ] && continue
                printf '  %3d) %s\n' "$i" "$tag"
                i=$((i+1))
            done <<< "$filtered"
            text_input "Choose a locale by number" "1"
            if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le "${#lines[@]}" ]; then
                LANG_CHOICE="${lines[$((REPLY-1))]}"
                break
            fi
            warn "Invalid selection."
        done
    fi
    rm -f "$map_file"

    LOCALE="$LANG_CHOICE"
    COUNTRY="${LOCALE#*_}"
    COUNTRY="${COUNTRY%.*}"
    ok "Locale: $LOCALE"
}

