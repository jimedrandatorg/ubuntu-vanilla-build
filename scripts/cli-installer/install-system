#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# ubuntu-cli-installer.sh — TTY/CLI-based Ubuntu installer for the
# Ubuntu Vanilla Build live ISO. Mirrors the Calamares module sequence
# defined in scripts/calamares/settings.conf:
#
#   welcome → locale → keyboard → partition → users → summary
#     → partition → mount → unpackfs → machineid → fstab → locale
#     → keyboard → localecfg → users → displaymanager → networkcfg
#     → hwclock → initramfscfg → initramfs → grubcfg → bootloader
#     → packages → umount → finished
#
# Usage (interactive, on the live ISO):
#   sudo ./ubuntu-cli-installer.sh
#
# The script is strictly interactive by design — every step asks the user
# on the TTY (text mode) or in whiptail/dialog boxes (TUI mode, picked
# once at the welcome screen).
#
# The script assumes it is running from the live ISO (casper). It looks
# for the squashfs at /cdrom/casper/filesystem.squashfs and aborts with a
# clear error if it is not present.

set -Eeuo pipefail
shopt -s nocasematch

